{
  "manifest_version": 3,
  "name": "Prepwise LeetCode Sync",
  "version": "0.2.0",
  "description": "Imports your own accepted LeetCode submissions (code, runtime, notes) into your local Prepwise app.",
  "permissions": ["storage"],
  "host_permissions": ["https://leetcode.com/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{ "matches": ["https://leetcode.com/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "web_accessible_resources": [{ "resources": ["lib/leetcode.js", "lib/sync.js", "lib/time.js"], "matches": ["https://leetcode.com/*"] }],
  "action": { "default_title": "Prepwise", "default_popup": "popup.html" }
}

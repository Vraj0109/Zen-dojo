{
  "name": "zen-dojo-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zen-dojo-db",
      "database_id": "a14794b5-d936-4913-ab5e-b157536dc4bb",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [

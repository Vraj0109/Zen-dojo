    {
      "name": "RL_SYNC",
      "namespace_id": "1002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "RL_IP",
      "namespace_id": "1003",
      "simple": {
        "limit": 300,
        "period": 60
      }
    }
  ],
  "vars": {

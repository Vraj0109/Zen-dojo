{
  "name": "zen-dojo",
  "version": "0.1.0",
  "private": true,
  "description": "Progress tracker for the SDE2/SWE3 prep roadmap",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "desktop": "pnpm --filter desktop start",
    "desktop:dev": "pnpm --filter desktop dev",
    "desktop:build": "pnpm --filter desktop dist",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fast": "vitest run --mode fast",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "content:build": "node scripts/build-content.mjs",
    "content:check": "node scripts/build-content.mjs --check",
    "solutions:build": "node --disable-warning=DEP0205 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/solutions.mjs build",
    "solutions:check": "node --disable-warning=DEP0205 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/solutions.mjs check",
    "solutions:status": "node --disable-warning=DEP0205 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/solutions.mjs status",
    "solutions:todo": "node --disable-warning=DEP0205 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/solutions.mjs todo",
    "solutions:verify": "node scripts/solutions-verify.mjs",
    "import:cp-algorithms": "node scripts/import-cp-algorithms.mjs",
    "pack:check": "node --disable-warning=DEP0205 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/pack-check.mjs",
    "content:add": "node --disable-warning=DEP0205 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/content.mjs add",
    "content:sync": "node --disable-warning=DEP0205 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/content.mjs sync",
    "content:list": "node --disable-warning=DEP0205 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/content.mjs list",
    "content:remove": "node --disable-warning=DEP0205 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/content.mjs remove",
    "content:export": "node --disable-warning=DEP0205 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/content.mjs export",
    "content:seed": "node --disable-warning=DEP0205 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/content.mjs seed",
    "faq:build": "node --disable-warning=DEP0205 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/faq.mjs",
    "pack:build":"node --disable-warning=DEP0205 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/pack-build.mjs"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "jsdom": "25.0.1",
    "katex": "^0.19.1",
    "marked": "^18.1.3",
    "vitest": "^5.1.0"
  }
}

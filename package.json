{
  "name": "zen-dojo",
  "version": "0.1.0",
  "private": true,
  "description": "Progress tracker for the SDE2/SWE3 prep roadmap",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "desktop": "pnpm --filter desktop start",
    "desktop:dev": "pnpm --filter desktop dev",
    "desktop:build": "pnpm --filter desktop dist",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fast": "vitest run --mode fast",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "pack:check": "node --disable-warning=DEP0205 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/pack-check.mjs",
    "content:fixture": "node --disable-warning=DEP0205 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/content-fixture.mjs",
    "content:resync": "node --disable-warning=DEP0205 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/content-resync.mjs",
    "content:snapshot": "node --disable-warning=DEP0205 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/content-snapshot.mjs",
    "content:pull": "node --disable-warning=DEP0205 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/content-snapshot.mjs --out data/content.db",
    "content:verify": "node --disable-warning=DEP0205 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/content-verify.mjs",
    "content:verify-solutions": "node --disable-warning=DEP0205 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/content-verify-solutions.mjs",
    "content:import": "node --disable-warning=DEP0205 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/content-import.mjs",
    "content:check-hosted": "node --disable-warning=DEP0205 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/content-check-hosted.mjs",
    "faq:build": "node --disable-warning=DEP0205 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/faq.mjs",
    "courses:catalog": "node --disable-warning=DEP0205 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/courses-catalog.mjs",
    "pack:build": "node --disable-warning=DEP0205 --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/lib/register-ts.mjs scripts/pack-build.mjs"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "jsdom": "25.0.1",
    "katex": "^0.19.1",
    "marked": "^18.1.3",
    "vitest": "^5.1.0"
  }
}

{
  "name": "prepwise",
  "version": "0.1.0",
  "private": true,
  "description": "Progress tracker for the SDE2/SWE3 prep roadmap",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "desktop": "pnpm --filter desktop start",
    "desktop:dev": "pnpm --filter desktop dev",
    "desktop:build": "pnpm --filter desktop dist",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "import:cp-algorithms": "node scripts/import-cp-algorithms.mjs"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "jsdom": "25.0.1",
    "katex": "^0.19.1",
    "marked": "^18.1.3",
    "vitest": "^5.1.0"
  }
}
